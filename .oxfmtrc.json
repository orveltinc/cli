{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "ignorePatterns": [
    "**/dist/",
    "**/lib/",
    "**/.output/",
    "**/.vinxi/",
    "**/coverage/",
    "**/node_modules/",
    "/.agents/",
    "/.cursor/skills/",
    "bun.lockb",
    "*.mdx",
    "*.db",
    "*.db-shm",
    "*.db-wal",
    "**/drizzle/",
    "**/.tanstack/",
    "**/tanstack/",
    "**/routeTree.gen.ts",
    "packages/landing-assets/generated/",
    "*.min.js",
    "*.min.css",
    "package-lock.json",
    "yarn.lock",
    "bun-lock.yaml",
    "bun.lock",
    "uv.lock",
    ".venv",
    ".ruff_cache",
    ".env",
    ".env.local",
    ".env.*.local",
    "**/src/components/ui/",
    "**/src/components/animate-ui/",
    "**/src/components/base-ui/",
    "packages/business-sdk/openapi.json",
    "packages/ui/src/components/**",
    "**/packages/database/src/drizzle/**",
    "**/packages/database/src/schema/**",
    "**/hooks/"
  ]
}
